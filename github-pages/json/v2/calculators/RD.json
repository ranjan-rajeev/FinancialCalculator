{
  "id": "RD",
  "name": "RD Calculator",
  "type": "CUSTOM",
  "version": 2,
  "category": "BANKING",
  "engine": "RD_CALCULATOR",
  "inputFields": [
    {
      "type": "EDIT_TEXT",
      "key": "monthlyDeposit",
      "label": "Monthly deposit",
      "inputType": "DECIMAL",
      "formatter": "CURRENCY_INR",
      "order": 1,
      "validation": {
        "required": true,
        "min": 1
      }
    },
    {
      "type": "EDIT_TEXT",
      "key": "rate",
      "label": "Interest rate (% p.a.)",
      "inputType": "DECIMAL",
      "formatter": "NONE",
      "order": 2,
      "validation": {
        "required": true,
        "min": 0,
        "max": 100
      }
    },
    {
      "type": "EDIT_TEXT",
      "key": "tenure",
      "label": "Tenure",
      "inputType": "DECIMAL",
      "formatter": "NONE",
      "order": 3,
      "validation": {
        "required": true,
        "min": 1
      }
    },
    {
      "type": "SPINNER",
      "key": "tenureType",
      "label": "Tenure type",
      "options": [
        {
          "label": "Years",
          "value": "YEARS"
        },
        {
          "label": "Months",
          "value": "MONTHS"
        }
      ],
      "defaultValue": "YEARS",
      "order": 4
    },
    {
      "type": "BUTTON",
      "key": "calculate",
      "label": "Calculate",
      "action": "CALCULATE",
      "style": "PRIMARY",
      "order": 5
    }
  ],
  "outputConfig": {
    "summary": [
      {
        "key": "totalInvested",
        "label": "Total invested",
        "type": "KEY_VALUE",
        "formatter": "CURRENCY_INR",
        "order": 1
      },
      {
        "key": "totalInterest",
        "label": "Interest earned",
        "type": "KEY_VALUE",
        "formatter": "CURRENCY_INR",
        "order": 2
      },
      {
        "key": "maturity",
        "label": "Maturity amount",
        "type": "KEY_VALUE",
        "formatter": "CURRENCY_INR",
        "order": 3
      }
    ],
    "breakdown": null,
    "charts": [],
    "formulas": []
  },
  "moreInfo": [
    {
      "question": "What is the total I deposit in RD?",
      "answer": "Total invested equals the monthly deposit multiplied by the number of months in the chosen tenure."
    }
  ]
}
